<!DOCTYPE html>
<html data-theme="dark" data-lang="zh">
<head>
<meta charset="UTF-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'self' 'unsafe-inline' https://video.laiai.ai https://fonts.googleapis.com https://fonts.gstatic.com; img-src 'self' https://video.laiai.ai data:; script-src 'self' 'unsafe-inline' blob:; font-src 'self' https://fonts.gstatic.com data:; worker-src 'self' blob:;">
<title>LaiaiAgent</title>
<link rel="stylesheet" href="vendor/xterm.css">
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap');

/* ═══ DESIGN TOKENS ═══ */
:root,[data-theme="dark"]{
  --bg-0:#07080D;--bg-1:#0C0E15;--bg-2:#12141D;--bg-3:#1A1D28;--bg-4:#232736;
  --bg-glass:rgba(18,20,29,0.75);--bg-glass-hover:rgba(26,29,40,0.85);
  --border-0:rgba(255,255,255,0.04);--border-1:rgba(255,255,255,0.07);--border-2:rgba(255,255,255,0.12);
  --t1:#F0F1F5;--t2:#A0A4B8;--t3:#5E6278;--t4:#3A3E50;
  --accent:#7C3AED;--accent-h:#6D28D9;--accent-l:#A78BFA;--accent-bg:rgba(124,58,237,0.10);--accent-bg2:rgba(124,58,237,0.18);
  --green:#34D399;--green-bg:rgba(52,211,153,0.10);--red:#F87171;--red-bg:rgba(248,113,113,0.10);
  --yellow:#FBBF24;--yellow-bg:rgba(251,191,36,0.10);--blue:#60A5FA;--blue-bg:rgba(96,165,250,0.10);
  --cyan:#22D3EE;--pink:#F472B6;--orange:#FB923C;
  --radius:10px;--radius-lg:14px;--radius-xl:20px;
  --shadow-md:0 4px 24px rgba(0,0,0,0.35);--shadow-lg:0 8px 40px rgba(0,0,0,0.5);
  --transition:all .2s cubic-bezier(.4,0,.2,1);
}
[data-theme="light"]{
  --bg-0:#F8F9FB;--bg-1:#F0F1F5;--bg-2:#FFFFFF;--bg-3:#E8EAF0;--bg-4:#D8DBE5;
  --bg-glass:rgba(255,255,255,0.8);--bg-glass-hover:rgba(240,241,245,0.9);
  --border-0:rgba(0,0,0,0.05);--border-1:rgba(0,0,0,0.09);--border-2:rgba(0,0,0,0.16);
  --t1:#111827;--t2:#374151;--t3:#6B7280;--t4:#9CA3AF;
  --accent:#7C3AED;--accent-h:#6D28D9;--accent-l:#7C3AED;--accent-bg:rgba(124,58,237,0.06);--accent-bg2:rgba(124,58,237,0.12);
  --green:#059669;--green-bg:rgba(5,150,105,0.08);--red:#DC2626;--red-bg:rgba(220,38,38,0.08);
  --yellow:#D97706;--yellow-bg:rgba(217,119,6,0.08);--blue:#2563EB;--blue-bg:rgba(37,99,235,0.08);
  --cyan:#0891B2;--pink:#DB2777;--orange:#EA580C;
  --shadow-md:0 4px 24px rgba(0,0,0,0.08);--shadow-lg:0 8px 40px rgba(0,0,0,0.12);
}

/* ═══ RESET ═══ */
*{margin:0;padding:0;box-sizing:border-box}
::selection{background:var(--accent-bg2)}
::-webkit-scrollbar{width:5px;height:5px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:var(--border-2);border-radius:3px}
::-webkit-scrollbar-thumb:hover{background:var(--t3)}
html,body{width:100%;height:100%;overflow:hidden;background:var(--bg-0);color:var(--t1);font-family:'Inter',system-ui,sans-serif;font-size:13px;-webkit-font-smoothing:antialiased}
button{font-family:inherit;cursor:pointer}
button:focus-visible,.btn:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:none;box-shadow:0 0 0 2px var(--accent-bg2),0 0 0 3px var(--accent)!important}
input,select,textarea{font-family:inherit}

/* ═══ APP LAYOUT ═══ */
#app{display:flex;flex-direction:column;height:100vh}
#main{display:flex;flex:1;overflow:hidden}

/* ═══ MODE RAIL ═══ */
#mode-rail{width:48px;background:var(--bg-1);border-right:1px solid var(--border-0);display:flex;flex-direction:column;align-items:center;padding:8px 0;gap:4px;flex-shrink:0}
.mr-btn{width:36px;height:36px;border:none;background:none;border-radius:10px;color:var(--t3);display:flex;align-items:center;justify-content:center;cursor:pointer;transition:var(--transition)}
.mr-btn:hover{background:var(--bg-3);color:var(--t1)}
.mr-btn.active{background:var(--accent-bg);color:var(--accent-l)}
.mr-btn svg{width:20px;height:20px}
.mr-spacer{flex:1}

/* ═══ SESSION SIDEBAR ═══ */
#session-sidebar{width:260px;background:var(--bg-1);border-right:1px solid var(--border-0);display:flex;flex-direction:column;flex-shrink:0;overflow:hidden}
.ss-header{padding:10px 12px 6px;flex-shrink:0}
.ss-new{width:100%;padding:8px 12px;border:1px dashed var(--border-2);background:none;border-radius:8px;color:var(--t2);font-size:12px;font-weight:600;cursor:pointer;display:flex;align-items:center;gap:6px;transition:var(--transition)}
.ss-new:hover{background:var(--accent-bg);color:var(--accent-l);border-color:var(--accent)}
.ss-search-wrap{padding:0 12px 8px;flex-shrink:0}
.ss-search{width:100%;padding:6px 10px;background:var(--bg-3);border:1px solid var(--border-1);border-radius:6px;color:var(--t1);font-size:11px;outline:none}
.ss-search:focus{border-color:var(--accent);box-shadow:0 0 0 2px var(--accent-bg)}
.ss-list{flex:1;overflow-y:auto;padding:0 8px}
.ss-item{display:flex;align-items:center;gap:8px;padding:8px 10px;border-radius:8px;cursor:pointer;margin-bottom:2px;transition:var(--transition)}
.ss-item:hover{background:var(--bg-3)}
.ss-item.active{background:var(--accent-bg)}
.ss-item-text{flex:1;min-width:0}
.ss-item-title{font-size:12px;font-weight:500;color:var(--t1);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ss-item.active .ss-item-title{color:var(--accent-l)}
.ss-item-meta{font-size:10px;color:var(--t4);margin-top:1px}
.ss-item-del{background:none;border:none;color:transparent;font-size:10px;cursor:pointer;padding:2px;border-radius:3px;transition:var(--transition)}
.ss-item:hover .ss-item-del{color:var(--t4)}
.ss-item-del:hover{color:var(--red)!important;background:var(--red-bg)}
.ss-date-label{font-size:10px;color:var(--t4);padding:8px 10px 4px;font-weight:600;text-transform:uppercase;letter-spacing:.5px}

/* ═══ MODE CONTENT ═══ */
.mode{display:none;flex:1;position:relative;overflow:hidden}
.mode.active{display:flex;flex-direction:column}

/* ═══ SETTINGS DRAWER ═══ */
#settings-overlay{position:fixed;inset:0;background:rgba(0,0,0,0.4);z-index:400;opacity:0;pointer-events:none;transition:opacity .25s;-webkit-backdrop-filter:blur(2px);backdrop-filter:blur(2px)}
#settings-overlay.open{opacity:1;pointer-events:auto}
#settings-drawer{position:fixed;top:0;right:-480px;width:480px;height:100%;background:var(--bg-0);border-left:1px solid var(--border-1);z-index:401;display:flex;flex-direction:column;transition:right .3s cubic-bezier(.4,0,.2,1);box-shadow:var(--shadow-lg)}
#settings-drawer.open{right:0}
.sd-header{height:48px;display:flex;align-items:center;padding:0 20px;border-bottom:1px solid var(--border-1);flex-shrink:0}
.sd-header h3{font-size:15px;font-weight:700;flex:1}
.sd-close{background:none;border:none;color:var(--t3);cursor:pointer;padding:4px;border-radius:6px;transition:var(--transition)}
.sd-close:hover{color:var(--t1);background:var(--bg-3)}
.sd-tabs{display:flex;border-bottom:1px solid var(--border-1);padding:0 16px;flex-shrink:0}
.sd-tab{padding:10px 16px;font-size:12px;font-weight:600;color:var(--t3);cursor:pointer;border-bottom:2px solid transparent;transition:var(--transition);white-space:nowrap}
.sd-tab:hover{color:var(--t2)}
.sd-tab.active{color:var(--accent-l);border-bottom-color:var(--accent)}
.sd-body{flex:1;overflow-y:auto;padding:20px}
.sd-panel{display:none}
.sd-panel.active{display:block}
.sd-section{margin-bottom:20px}
.sd-section-title{font-size:11px;font-weight:700;color:var(--t3);text-transform:uppercase;letter-spacing:.8px;margin-bottom:10px}
.sd-row{display:flex;align-items:center;justify-content:space-between;padding:10px 14px;background:var(--bg-2);border:1px solid var(--border-1);border-radius:8px;margin-bottom:6px}
.sd-row-label{font-size:13px;font-weight:500}
.sd-row-desc{font-size:11px;color:var(--t3);margin-top:1px}
.sd-select{padding:5px 10px;background:var(--bg-3);border:1px solid var(--border-1);border-radius:6px;color:var(--t1);font-size:12px;outline:none}

/* ═══ TITLEBAR ═══ */
#titlebar{height:40px;display:flex;align-items:center;background:var(--bg-1);-webkit-app-region:drag;flex-shrink:0;border-bottom:1px solid var(--border-0);z-index:200}
.tb-brand{display:flex;align-items:center;gap:8px;padding:0 16px;-webkit-app-region:no-drag}
.tb-brand img{width:18px;height:18px;border-radius:4px}
.tb-brand span{font-size:13px;font-weight:800;letter-spacing:-.2px;background:linear-gradient(135deg,var(--accent-l),var(--accent),var(--pink));background-size:200% 200%;-webkit-background-clip:text;-webkit-text-fill-color:transparent;animation:brandShimmer 8s ease infinite}
@keyframes brandShimmer{0%,100%{background-position:0% 50%}50%{background-position:100% 50%}}
.tb-version{font-size:9px;color:var(--t3);font-family:'JetBrains Mono',monospace;background:var(--bg-3);padding:2px 6px;border-radius:4px;letter-spacing:.5px}
.tb-spacer{flex:1}
.tb-controls{display:flex;-webkit-app-region:no-drag;height:100%}
.wb{width:46px;height:100%;border:none;background:none;color:var(--t3);display:flex;align-items:center;justify-content:center;transition:var(--transition)}
.wb:hover{background:var(--bg-3);color:var(--t1)}
.wb.x:hover{background:#DC2626;color:#fff}
.wb svg{width:11px;height:11px}

/* ═══ BODY ═══ */
/* #body removed, replaced by #main */

/* ═══ OLD SIDEBAR CSS REMOVED (Phase 0) ═══ */
#sidebar.expanded .si-toggle svg{transform:rotate(180deg)}

/* ═══ CONTENT ═══ */
#content{flex:1;overflow:hidden;background:var(--bg-0);position:relative}
.page{position:absolute;inset:0;flex-direction:column;overflow:hidden;background:var(--bg-0);visibility:hidden;pointer-events:none;display:flex}
.page.active{visibility:visible;pointer-events:auto}

/* ═══ PAGE HEADER ═══ */
.ph{padding:20px 28px 14px;flex-shrink:0}
.ph h2{font-size:18px;font-weight:700;letter-spacing:-.3px}
.ph p{font-size:12px;color:var(--t3);margin-top:2px}
.ph-actions{display:flex;gap:8px;margin-top:12px}
.pb{flex:1;overflow-y:auto;padding:0 28px 28px}

/* ═══ BUTTONS ═══ */
.btn{padding:7px 14px;border:none;border-radius:8px;font-size:12px;font-weight:600;display:inline-flex;align-items:center;gap:6px;transition:var(--transition)}
.btn svg{width:14px;height:14px}
.btn-p{background:linear-gradient(135deg,var(--accent),var(--accent-h));color:#fff;box-shadow:0 2px 12px rgba(124,58,237,0.25)}
.btn-p:hover{background:linear-gradient(135deg,var(--accent-h),#5B21B6);transform:translateY(-1px);box-shadow:0 4px 20px rgba(124,58,237,0.4)}
.btn-p:active{transform:translateY(0)}
.btn-p:disabled{opacity:.4;cursor:not-allowed;transform:none;box-shadow:none}
.btn-s{background:var(--bg-3);color:var(--t2);border:1px solid var(--border-1)}
.btn-s:hover{background:var(--bg-4);color:var(--t1)}
.btn-g{background:none;color:var(--t3);padding:6px 8px}
.btn-g:hover{color:var(--t1);background:var(--bg-3)}
.btn-d{background:var(--red-bg);color:var(--red)}
.btn-d:hover{box-shadow:inset 0 0 0 1px var(--red)}
.btn-sm{padding:5px 10px;font-size:11px;border-radius:6px}
.btn-lg{padding:11px 22px;font-size:14px;border-radius:var(--radius)}

/* ═══ CARDS ═══ */
.card{background:var(--bg-2);border:1px solid var(--border-1);border-radius:var(--radius-lg);padding:18px 22px;transition:var(--transition)}
.card:hover{border-color:var(--border-2)}
.card+.card{margin-top:12px}
.card-h{display:flex;align-items:center;gap:8px;margin-bottom:14px;font-size:13px;font-weight:600}
.card-h svg{width:16px;height:16px;color:var(--accent-l)}

/* ═══ FORM ═══ */
.f{margin-bottom:12px}.f:last-child{margin-bottom:0}
.f label{display:block;font-size:10px;font-weight:600;color:var(--t3);text-transform:uppercase;letter-spacing:.5px;margin-bottom:4px}
.f input,.f select{width:100%;padding:8px 12px;background:var(--bg-3);border:1px solid var(--border-1);border-radius:8px;color:var(--t1);font-size:12px;font-family:'JetBrains Mono',monospace;outline:none;transition:var(--transition)}
.f input:focus,.f select:focus{border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-bg)}
.f input::placeholder{color:var(--t4)}
.f .hint{font-size:10px;color:var(--t4);margin-top:2px}
.ig{display:flex}.ig input{border-radius:8px 0 0 8px;border-right:none}.ig button{padding:0 10px;background:var(--bg-4);border:1px solid var(--border-1);border-radius:0 8px 8px 0;color:var(--t3);transition:var(--transition)}.ig button:hover{color:var(--t1)}

/* ═══ TERMINAL PAGE ═══ */
.term-bar{position:absolute;top:0;left:0;right:0;height:42px;display:flex;align-items:center;padding:0 16px;gap:10px;background:var(--bg-2);border-bottom:1px solid var(--border-1);z-index:10}
.term-bar .dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.term-bar .status{font-size:11px;font-weight:600;color:var(--t3)}
.term-bar .spacer{flex:1}
.term-sel{padding:4px 8px;background:var(--bg-3);border:1px solid var(--border-1);border-radius:6px;color:var(--t2);font-size:11px;outline:none}
.term-mode-tabs{display:flex;gap:2px;background:var(--bg-3);border-radius:6px;padding:2px}
.term-mode-tab{padding:4px 12px;border:none;background:none;color:var(--t3);font-size:11px;font-weight:600;border-radius:5px;cursor:pointer;transition:var(--transition)}
.term-mode-tab.active{background:var(--accent);color:#fff}
#term-area{position:absolute;top:0;left:0;right:0;bottom:0;background:var(--bg-0);overflow:hidden}
/* Terminal and Chat are stacked, controlled by .mode-chat / .mode-terminal on #term-area */
#term-container{position:absolute;inset:4px;display:none}
#term-area.mode-terminal #term-container{display:block}
#term-area.mode-terminal .tw{display:none}

/* Welcome / Web UI chat view */
.tw{position:absolute;inset:0;display:flex;flex-direction:column;background:var(--bg-0);overflow:hidden}
.tw-main{flex:1;overflow-y:auto;display:flex;flex-direction:column;padding:20px 0}
.tw-main-inner{max-width:760px;width:100%;margin:0 auto;padding:0 24px}
/* Hero (shown when no messages) */
.tw-hero{text-align:center;padding:40px 0 24px;display:flex;flex-direction:column;align-items:center}
.tw-hero-logo{width:48px;height:48px;border-radius:14px;box-shadow:0 0 40px rgba(124,58,237,0.15);margin-bottom:12px}
.tw-hero h2{font-size:22px;font-weight:800;letter-spacing:-.3px;margin-bottom:6px}
.tw-hero .tw-subtitle{font-size:13px;color:var(--t3);line-height:1.6}
.tw-hero .tw-feature{display:inline-block;font-size:11px;color:var(--accent-l);background:var(--accent-bg);padding:4px 14px;border-radius:20px;margin-top:10px;font-weight:600}
.tw-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px;width:100%;max-width:680px;margin:16px auto 0}
.tw-card{padding:14px;background:var(--bg-2);border:1px solid var(--border-1);border-radius:var(--radius-lg);cursor:pointer;transition:var(--transition);display:flex;gap:12px;align-items:flex-start}
.tw-card:hover{border-color:var(--accent);transform:translateY(-2px);box-shadow:var(--shadow-md)}
.tw-card-icon{width:34px;height:34px;border-radius:9px;background:var(--accent-bg);color:var(--accent-l);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.tw-card-icon svg{width:16px;height:16px}
.tw-card-body{flex:1}
.tw-card-t{font-size:12px;font-weight:700;margin-bottom:2px}
.tw-card-d{font-size:11px;color:var(--t3);line-height:1.4}
/* Chat messages */
.chat-messages{display:flex;flex-direction:column;gap:16px;padding-bottom:16px}
.chat-msg{display:flex;gap:10px;animation:fadeIn .3s ease}
.chat-msg.user{flex-direction:row-reverse}
.chat-avatar{width:30px;height:30px;border-radius:8px;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700}
.chat-msg.user .chat-avatar{background:var(--accent);color:#fff}
.chat-msg.ai .chat-avatar{background:var(--bg-3);color:var(--accent-l)}
.chat-msg.ai .chat-avatar img{width:30px;height:30px;border-radius:8px}
.chat-bubble{max-width:85%;padding:12px 16px;border-radius:14px;font-size:13px;line-height:1.7}
.chat-msg.user .chat-bubble{background:var(--accent);color:#fff;border-bottom-right-radius:4px}
.chat-msg.ai .chat-bubble{background:var(--bg-2);border:1px solid var(--border-1);border-bottom-left-radius:4px;color:var(--t1)}
.chat-bubble pre{background:var(--bg-3);border:1px solid var(--border-1);border-radius:8px;padding:10px 14px;margin:8px 0;overflow-x:auto;font-family:'JetBrains Mono',monospace;font-size:12px;line-height:1.5}
.chat-bubble code{font-family:'JetBrains Mono',monospace;font-size:12px;background:var(--bg-3);padding:1px 5px;border-radius:4px}
.chat-bubble pre code{background:none;padding:0}
.chat-typing{display:flex;align-items:center;gap:6px;padding:6px 0}
.chat-typing span{width:7px;height:7px;border-radius:50%;background:var(--accent-l);opacity:.4;animation:breathe 1.4s ease-in-out infinite}
.chat-typing span:nth-child(2){animation-delay:.2s}
.chat-typing span:nth-child(3){animation-delay:.4s}
@keyframes breathe{0%,100%{opacity:.3;transform:scale(.7)}50%{opacity:1;transform:scale(1.1)}}
/* Chat session tabs */
.chat-topbar{display:flex;align-items:center;height:36px;border-bottom:1px solid var(--border-1);background:var(--bg-1);flex-shrink:0;padding:0 8px;gap:4px}
.chat-sessions-scroll{flex:1;display:flex;gap:4px;overflow-x:auto;align-items:center;padding:4px 0}
.chat-sessions-scroll::-webkit-scrollbar{height:0}
.chat-sess-item{display:flex;align-items:center;gap:4px;padding:4px 10px;border-radius:6px;font-size:11px;font-weight:500;color:var(--t3);cursor:pointer;white-space:nowrap;transition:var(--transition);flex-shrink:0}
.chat-sess-item:hover{background:var(--bg-3);color:var(--t2)}
.chat-sess-item.active{background:var(--accent-bg);color:var(--accent-l)}
.chat-sess-title{max-width:120px;overflow:hidden;text-overflow:ellipsis}
.chat-sess-del{background:none;border:none;color:var(--t4);font-size:10px;cursor:pointer;padding:0 2px;line-height:1;transition:color .15s}
.chat-sess-del:hover{color:var(--red)}
.chat-new-btn{width:28px;height:28px;border:1px dashed var(--border-2);background:none;border-radius:6px;color:var(--t3);display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0;transition:var(--transition)}
.chat-new-btn:hover{background:var(--accent-bg);color:var(--accent-l);border-color:var(--accent)}

/* [+] Action button */
.action-plus{width:40px;height:40px;border:1px solid var(--border-2);background:none;border-radius:50%;color:var(--t2);display:flex;align-items:center;justify-content:center;cursor:pointer;transition:var(--transition);flex-shrink:0}
.action-plus:hover{background:var(--accent-bg);color:var(--accent-l);border-color:var(--accent);transform:rotate(90deg)}
/* Input footer */
.chat-input-footer{max-width:760px;margin:4px auto 0;display:flex;align-items:center;gap:8px;padding:0 50px}
.chat-input-hint{font-size:10px;color:var(--t4);margin-left:auto}
/* Chat toolbar (legacy compat) */
.chat-toolbar{max-width:760px;margin:0 auto;display:flex;align-items:center;gap:4px;padding:0 0 6px}
.ct-btn{display:flex;align-items:center;gap:4px;padding:4px 10px;border:1px solid var(--border-1);background:none;border-radius:8px;color:var(--t3);font-size:11px;font-weight:500;cursor:pointer;transition:var(--transition);white-space:nowrap}
.ct-btn:hover{background:var(--bg-3);color:var(--t1);border-color:var(--border-2)}
.ct-btn.active{background:var(--accent-bg);color:var(--accent-l);border-color:var(--accent)}
.ct-btn svg{width:14px;height:14px}
.ct-sep{width:1px;height:16px;background:var(--border-1);margin:0 2px}
.ct-model{padding:4px 10px;background:var(--bg-3);border:1px solid var(--border-1);border-radius:8px;color:var(--accent-l);font-size:11px;font-weight:600;font-family:'JetBrains Mono',monospace;cursor:pointer;outline:none;margin-left:auto}
/* Dropdown menu */
.ct-menu{position:absolute;bottom:calc(100% + 4px);left:0;background:var(--bg-2);border:1px solid var(--border-2);border-radius:var(--radius);padding:6px;min-width:200px;box-shadow:var(--shadow-lg);z-index:20;display:none}
.ct-menu.show{display:block}
.ct-menu-item{display:flex;align-items:center;gap:8px;padding:8px 12px;border-radius:6px;font-size:12px;color:var(--t2);cursor:pointer;transition:var(--transition)}
.ct-menu-item:hover{background:var(--bg-3);color:var(--t1)}
.ct-menu-item svg{width:16px;height:16px;color:var(--t3)}

/* Chat input at bottom */
.tw-input-area{padding:12px 24px 16px;border-top:1px solid var(--border-1);background:var(--bg-1);flex-shrink:0}
.tw-input-wrap{max-width:760px;margin:0 auto;display:flex;gap:8px;align-items:flex-end}
.tw-input{flex:1;padding:12px 16px;background:var(--bg-3);border:1px solid var(--border-1);border-radius:14px;color:var(--t1);font-size:13px;outline:none;transition:var(--transition);font-family:'Inter',sans-serif;resize:none;max-height:120px;min-height:44px}
.tw-input:focus{border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-bg)}
.tw-input::placeholder{color:var(--t4)}
.tw-send{width:44px;height:44px;border:none;background:var(--accent);color:#fff;border-radius:12px;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:var(--transition);flex-shrink:0}
.tw-send:hover{background:var(--accent-h);transform:scale(1.05)}
.tw-send:disabled{opacity:.3;cursor:not-allowed;transform:none}
.tw-send svg{width:18px;height:18px}
.tw-hint{text-align:center;font-size:10px;color:var(--t4);margin-top:6px;max-width:760px;margin-left:auto;margin-right:auto}

.term-loading{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;background:var(--bg-0);z-index:3}
.term-loading .spinner{width:32px;height:32px;border:3px solid var(--border-2);border-top-color:var(--accent);border-radius:50%;animation:spin .8s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}

/* ═══ SIDEBAR TOOLTIP ═══ */
.si[title]{position:relative}
#sidebar:not(.expanded) .si::after{content:attr(data-tip);position:absolute;left:52px;top:50%;transform:translateY(-50%);background:var(--bg-4);color:var(--t1);font-size:11px;font-weight:600;padding:4px 10px;border-radius:6px;white-space:nowrap;opacity:0;pointer-events:none;transition:opacity .15s;z-index:100;box-shadow:var(--shadow-md)}
#sidebar:not(.expanded) .si:hover::after{opacity:1}

/* ═══ PAGE TRANSITION ═══ */
.page.active{animation:pageIn .2s ease}

/* ═══ PROVIDER ITEMS ═══ */
.prov-item{display:flex;align-items:center;padding:14px 16px;background:var(--bg-2);border:1px solid var(--border-1);border-radius:var(--radius-lg);gap:12px;transition:var(--transition);cursor:pointer}
.prov-item:hover{border-color:var(--border-2);transform:translateY(-1px);box-shadow:var(--shadow-md)}
.prov-item+.prov-item{margin-top:8px}
.prov-item.default{border-color:var(--accent);background:var(--accent-bg)}
.prov-icon{width:38px;height:38px;border-radius:var(--radius);display:flex;align-items:center;justify-content:center;font-size:17px;font-weight:800;flex-shrink:0}
.prov-info{flex:1;min-width:0}
.prov-name{font-size:13px;font-weight:600}
.prov-url{font-size:11px;color:var(--t4);font-family:'JetBrains Mono',monospace;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.prov-meta{display:flex;align-items:center;gap:8px;font-size:11px;color:var(--t3)}
.prov-acts{display:flex;gap:4px}

/* ═══ MODEL CARDS ═══ */
.model-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:8px}
.mc{padding:10px 14px;background:var(--bg-2);border:1px solid var(--border-1);border-radius:8px;cursor:pointer;transition:var(--transition)}
.mc:hover{border-color:var(--accent);transform:translateY(-1px);box-shadow:var(--shadow-md)}
.mc.sel{border-color:var(--accent);background:var(--accent-bg)}
.mc-id{font-size:12px;font-weight:600;font-family:'JetBrains Mono',monospace;margin-bottom:4px;color:var(--t1)}
.mc-prov{font-size:10px;color:var(--t3)}
.mc-tags{display:flex;gap:4px;margin-top:8px;flex-wrap:wrap}
.tag{font-size:8px;padding:2px 6px;border-radius:4px;font-weight:700;text-transform:uppercase;letter-spacing:.3px}
.tag-v{background:var(--blue-bg);color:var(--blue)}
.tag-t{background:var(--green-bg);color:var(--green)}
.tag-r{background:var(--yellow-bg);color:var(--yellow)}
.tag-f{background:var(--accent-bg);color:var(--accent-l)}

/* ═══ SESSION LIST ═══ */
.sess-item{display:flex;align-items:center;padding:12px 16px;background:var(--bg-2);border:1px solid var(--border-1);border-radius:var(--radius);gap:12px;transition:var(--transition);cursor:pointer}
.sess-item:hover{border-color:var(--border-2);background:var(--bg-3)}
.sess-item+.sess-item{margin-top:6px}
.sess-icon{width:32px;height:32px;border-radius:8px;background:var(--accent-bg);color:var(--accent-l);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.sess-icon svg{width:14px;height:14px}
.sess-body{flex:1;min-width:0}
.sess-title{font-size:12px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.sess-meta{font-size:10px;color:var(--t3);display:flex;gap:8px;margin-top:2px}
.sess-size{font-size:10px;color:var(--t4);flex-shrink:0}

/* ═══ TOOL GRID ═══ */
.tool-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:8px}
.tc{padding:12px 14px;background:var(--bg-2);border:1px solid var(--border-1);border-radius:var(--radius);transition:var(--transition)}
.tc:hover{border-color:var(--accent);background:var(--bg-3)}
.tc-name{font-size:12px;font-weight:700;font-family:'JetBrains Mono',monospace;color:var(--accent-l);margin-bottom:3px}
.tc-desc{font-size:11px;color:var(--t3);line-height:1.4}
.tc-cat{font-size:9px;color:var(--t4);text-transform:uppercase;letter-spacing:.5px;margin-top:6px;font-weight:600}

/* ═══ SETTINGS ═══ */
.set-item{display:flex;align-items:center;justify-content:space-between;padding:12px 16px;background:var(--bg-2);border:1px solid var(--border-1);border-radius:var(--radius)}
.set-item+.set-item{margin-top:6px}
.set-label{font-size:13px;font-weight:500}
.set-desc{font-size:11px;color:var(--t3);margin-top:1px}
.sel{padding:5px 8px;background:var(--bg-3);border:1px solid var(--border-1);border-radius:6px;color:var(--t1);font-size:11px;outline:none}

/* ═══ ABOUT ═══ */
.about-center{display:flex;flex-direction:column;align-items:center;padding-top:56px;text-align:center}
.about-logo{width:80px;height:80px;border-radius:var(--radius-xl);margin-bottom:16px;box-shadow:0 8px 32px rgba(124,58,237,0.2)}
.about-name{font-size:24px;font-weight:800;letter-spacing:-.5px;background:linear-gradient(135deg,var(--accent-l),var(--accent));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.about-ver{font-size:12px;color:var(--t3);font-family:'JetBrains Mono',monospace;margin:4px 0 20px}
.about-desc{font-size:13px;color:var(--t2);max-width:420px;line-height:1.7;margin-bottom:28px}

/* ═══ STATUS BAR ═══ */
#statusbar{height:26px;display:flex;align-items:center;padding:0 16px;gap:16px;background:var(--bg-1);border-top:1px solid var(--border-0);font-size:10px;color:var(--t3);flex-shrink:0;font-family:'JetBrains Mono',monospace}
.sb-dot{width:6px;height:6px;border-radius:50%}
.sb-sep{width:1px;height:12px;background:var(--border-1)}

/* ═══ MODAL ═══ */
.modal-bg{position:fixed;inset:0;background:rgba(0,0,0,0.55);z-index:500;display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .2s;backdrop-filter:blur(4px)}
.modal-bg.show{opacity:1;pointer-events:auto}
.modal{background:var(--bg-2);border:1px solid var(--border-1);border-radius:var(--radius-xl);padding:24px 28px;width:90%;max-width:500px;box-shadow:var(--shadow-lg);transform:scale(.96);transition:transform .2s}
.modal-bg.show .modal{transform:scale(1)}
.modal-title{font-size:16px;font-weight:700;margin-bottom:16px}
.modal-foot{display:flex;justify-content:flex-end;gap:8px;margin-top:20px}
.presets{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-bottom:16px}
.preset{padding:10px;background:var(--bg-3);border:1px solid var(--border-1);border-radius:var(--radius);cursor:pointer;text-align:center;font-size:11px;font-weight:600;transition:var(--transition)}
.preset:hover{border-color:var(--accent);background:var(--accent-bg)}
.preset.on{border-color:var(--accent);background:var(--accent-bg);color:var(--accent-l)}
.preset-i{font-size:18px;margin-bottom:2px}

/* ═══ ONBOARDING ═══ */
#onboarding{position:fixed;inset:0;background:var(--bg-0);z-index:1000;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20px}
#onboarding.hidden{display:none}
.ob-logo{width:64px;height:64px;border-radius:16px;box-shadow:0 8px 32px rgba(124,58,237,0.25)}
.ob-title{font-size:22px;font-weight:800;letter-spacing:-.3px}
.ob-sub{font-size:13px;color:var(--t2);max-width:400px;text-align:center;line-height:1.6}
.ob-card{background:var(--bg-2);border:1px solid var(--border-1);border-radius:var(--radius-xl);padding:24px 28px;width:100%;max-width:460px}
.ob-steps{display:flex;gap:6px;margin-bottom:16px}
.ob-step{flex:1;height:3px;border-radius:2px;background:var(--bg-4);transition:background .3s}
.ob-step.done{background:var(--accent)}
.ob-step.cur{background:var(--accent);opacity:.5}

/* ═══ EMPTY STATE ═══ */
.empty{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:56px 20px;color:var(--t4)}
.empty svg{width:44px;height:44px;margin-bottom:14px;opacity:.3}
.empty h3{font-size:14px;font-weight:600;color:var(--t3);margin-bottom:3px}
.empty p{font-size:12px;text-align:center;max-width:280px;line-height:1.5}

/* ═══ TOAST ═══ */
.toast{position:fixed;bottom:36px;left:50%;transform:translateX(-50%) translateY(16px);background:var(--bg-3);border:1px solid var(--border-2);border-radius:var(--radius);padding:8px 18px;font-size:12px;font-weight:500;color:var(--t2);opacity:0;pointer-events:none;z-index:999;box-shadow:var(--shadow-lg);transition:all .25s}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

/* ═══ MCP ITEMS ═══ */
.mcp-item{display:flex;align-items:center;padding:12px 16px;background:var(--bg-2);border:1px solid var(--border-1);border-radius:var(--radius);gap:12px;transition:var(--transition)}
.mcp-item:hover{border-color:var(--border-2)}
.mcp-item+.mcp-item{margin-top:6px}
.mcp-icon{width:32px;height:32px;border-radius:8px;background:var(--cyan);color:#fff;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:14px;font-weight:700}
.mcp-info{flex:1;min-width:0}
.mcp-name{font-size:12px;font-weight:600;font-family:'JetBrains Mono',monospace}
.mcp-type{font-size:10px;color:var(--t3)}
.mcp-scope{font-size:9px;padding:2px 6px;border-radius:4px;font-weight:600;text-transform:uppercase}
.mcp-scope-user{background:var(--blue-bg);color:var(--blue)}
.mcp-scope-project{background:var(--green-bg);color:var(--green)}

/* ═══ USAGE CHART ═══ */
.usage-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:12px;margin-bottom:20px}
.usage-card{padding:18px;background:var(--bg-2);border:1px solid var(--border-1);border-radius:var(--radius-lg);text-align:center}
.usage-val{font-size:28px;font-weight:800;letter-spacing:-.5px;margin-bottom:2px}
.usage-label{font-size:11px;color:var(--t3);text-transform:uppercase;letter-spacing:.5px;font-weight:600}
.chart-bar-row{display:flex;align-items:center;gap:8px;margin-bottom:4px}
.chart-label{width:70px;font-size:10px;color:var(--t3);text-align:right;font-family:'JetBrains Mono',monospace}
.chart-bar{flex:1;height:18px;background:var(--bg-3);border-radius:4px;overflow:hidden;position:relative}
.chart-fill{height:100%;border-radius:4px;transition:width .5s ease}
.chart-count{position:absolute;right:6px;top:50%;transform:translateY(-50%);font-size:9px;font-weight:600;color:var(--t2)}

/* ═══ SPLASH ═══ */
#splash{position:fixed;inset:0;background:var(--bg-0);z-index:2000;display:flex;flex-direction:column;align-items:center;justify-content:center;transition:opacity .5s}
#splash.hide{opacity:0;pointer-events:none}
#splash .sp-logo{width:72px;height:72px;border-radius:18px;box-shadow:0 0 60px rgba(124,58,237,0.3);animation:sp-pulse 2s ease-in-out infinite}
#splash .sp-text{margin-top:16px;font-size:18px;font-weight:800;background:linear-gradient(135deg,var(--accent-l),var(--accent));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
#splash .sp-sub{margin-top:6px;font-size:11px;color:var(--t4);letter-spacing:1px;text-transform:uppercase}
#splash .sp-bar{width:120px;height:3px;background:var(--bg-3);border-radius:2px;margin-top:24px;overflow:hidden}
#splash .sp-fill{width:0%;height:100%;background:linear-gradient(90deg,var(--accent),var(--accent-l));border-radius:2px;animation:sp-load 1.8s ease forwards}
@keyframes sp-pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.04)}}
@keyframes sp-load{0%{width:0%}50%{width:70%}100%{width:100%}}

/* ═══ IDE LAYOUT ═══ */
#page-ide{background:var(--bg-0);flex:1;position:relative}
.ide-layout{position:absolute;inset:0;display:flex;overflow:hidden}
/* File Tree — VS Code style */
.ide-filetree{width:240px;background:var(--bg-1);border-right:1px solid var(--border-0);display:flex;flex-direction:column;flex-shrink:0;overflow:hidden}
.ft-header{height:32px;display:flex;align-items:center;padding:0 12px;font-size:11px;font-weight:600;color:var(--t3);text-transform:uppercase;letter-spacing:.8px;flex-shrink:0}
.ft-header span{flex:1}
.ft-header button{background:none;border:none;color:var(--t4);cursor:pointer;padding:2px;border-radius:3px;transition:var(--transition)}
.ft-header button:hover{color:var(--t1);background:var(--bg-3)}
.ft-list{flex:1;overflow-y:auto;padding:2px 0}
.ft-item{display:flex;align-items:center;gap:4px;padding:2px 8px;cursor:pointer;font-size:12px;color:var(--t2);transition:background .08s;white-space:nowrap;overflow:hidden;height:22px}
.ft-item:hover{background:var(--bg-3)}
.ft-item.active{background:var(--accent-bg);color:var(--accent-l)}
.ft-item.dir{color:var(--t1);font-weight:500}
.ft-indent{flex-shrink:0;display:inline-block}
.ft-icon{width:16px;height:16px;flex-shrink:0;display:flex;align-items:center;justify-content:center}
.ft-icon svg{width:14px;height:14px;opacity:.7}
.ft-name{overflow:hidden;text-overflow:ellipsis;font-size:12px}
/* Editor Area — maximized */
.ide-center{flex:1;display:flex;flex-direction:column;min-width:200px;overflow:hidden}
/* Editor Tabs — VS Code style */
.editor-tabs{height:35px;display:flex;align-items:stretch;background:var(--bg-1);border-bottom:1px solid var(--border-0);overflow-x:auto;flex-shrink:0}
.editor-tabs::-webkit-scrollbar{height:0}
.ed-tab{display:flex;align-items:center;gap:6px;padding:0 12px;font-size:12px;color:var(--t3);cursor:pointer;border-right:1px solid var(--border-0);white-space:nowrap;transition:background .1s;flex-shrink:0;max-width:160px;position:relative}
.ed-tab:hover{background:var(--bg-3);color:var(--t2)}
.ed-tab.active{background:var(--bg-0);color:var(--t1)}
.ed-tab.active::after{content:'';position:absolute;bottom:0;left:0;right:0;height:2px;background:var(--accent)}
.ed-tab.dirty .ed-tab-name::after{content:'';display:inline-block;width:6px;height:6px;background:var(--accent-l);border-radius:50%;margin-left:6px;vertical-align:middle}
.ed-tab.preview .ed-tab-name{font-style:italic;opacity:.7}
.ed-tab-name{overflow:hidden;text-overflow:ellipsis;font-size:12px}
.ed-tab-close{background:none;border:none;color:transparent;font-size:10px;cursor:pointer;padding:2px;line-height:1;border-radius:3px;transition:var(--transition)}
.ed-tab:hover .ed-tab-close,.ed-tab.active .ed-tab-close{color:var(--t4)}
.ed-tab-close:hover{background:var(--bg-4);color:var(--red)!important}
.ed-welcome{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;color:var(--t3);padding:40px}
.ed-welcome h3{font-size:16px;font-weight:600;color:var(--t2)}
.ed-welcome p{font-size:12px;max-width:300px;text-align:center;line-height:1.6}
#monaco-container{flex:1;overflow:hidden;position:relative}
#monaco-container .monaco-editor{display:none}
#monaco-container.has-tabs .monaco-editor{display:block}
#monaco-container.has-tabs .ed-welcome{display:none!important}
/* Chat Panel — narrower, VS Code panel style */
/* Chat panel: hidden by default, toggled via button */
.ide-chat{width:360px;border-left:1px solid var(--border-0);display:none;flex-direction:column;background:var(--bg-0);flex-shrink:0;overflow:hidden}
.ide-chat.open{display:flex}
/* Resize Handle */
.resize-handle{width:4px;cursor:col-resize;background:transparent;flex-shrink:0;transition:background .2s}
.resize-handle:hover,.resize-handle.dragging{background:var(--accent)}

/* Quick Open (Ctrl+P) */
.quick-open-overlay{position:fixed;inset:0;background:rgba(0,0,0,0.4);z-index:300;display:none;align-items:flex-start;justify-content:center;padding-top:80px;-webkit-backdrop-filter:blur(2px);backdrop-filter:blur(2px)}
.quick-open-overlay.show{display:flex}
.quick-open{width:500px;background:var(--bg-2);border:1px solid var(--border-2);border-radius:var(--radius-lg);box-shadow:var(--shadow-lg);overflow:hidden}
.qo-input{width:100%;padding:14px 18px;background:transparent;border:none;color:var(--t1);font-size:14px;outline:none;font-family:'Inter',sans-serif}
.qo-input::placeholder{color:var(--t4)}
.qo-list{max-height:300px;overflow-y:auto;border-top:1px solid var(--border-1)}
.qo-item{display:flex;align-items:center;gap:8px;padding:8px 18px;cursor:pointer;font-size:12px;color:var(--t2);transition:background .1s}
.qo-item:hover,.qo-item.selected{background:var(--accent-bg);color:var(--t1)}
.qo-item .qo-path{color:var(--t4);font-size:10px;margin-left:auto;font-family:'JetBrains Mono',monospace}
/* IDE Bottom Terminal — VS Code style panel */
.ide-bottom-term{border-top:1px solid var(--border-0);background:#07080D;display:none;flex-direction:column;flex-shrink:0;min-height:0}
.ide-bottom-term.show{display:flex}
.ide-bottom-term-bar{height:30px;display:flex;align-items:center;padding:0 12px;background:var(--bg-2);font-size:11px;font-weight:600;color:var(--t3);gap:8px;cursor:ns-resize;flex-shrink:0;border-top:2px solid transparent;user-select:none}
.ide-bottom-term-bar:hover{border-top-color:var(--accent)}
#ide-term-container{height:280px;min-height:120px;max-height:70vh;overflow:hidden;background:#07080D;padding:4px}
/* File tree git status */
.ft-git-m{color:var(--yellow);font-size:9px;margin-left:auto;font-weight:700}
.ft-git-a{color:var(--green);font-size:9px;margin-left:auto;font-weight:700}
.ft-git-d{color:var(--red);font-size:9px;margin-left:auto;font-weight:700}
/* Code action buttons in chat */
.code-action{display:inline-flex;align-items:center;gap:4px;padding:3px 8px;background:var(--accent-bg);color:var(--accent-l);border:none;border-radius:4px;font-size:10px;font-weight:600;cursor:pointer;margin-top:4px;transition:var(--transition)}
.code-action:hover{background:var(--accent);color:#fff}

/* ═══ INLINE RESULT AREA ═══ */
.result-area{margin-top:14px;padding:16px;background:var(--bg-3);border:1px solid var(--border-1);border-radius:var(--radius);font-size:12px;font-family:'JetBrains Mono',monospace;color:var(--t2);white-space:pre-wrap;max-height:400px;overflow-y:auto;line-height:1.6;display:none}
.result-area.show{display:block;animation:fadeIn .2s ease}
.result-area.loading{display:flex;align-items:center;gap:8px;color:var(--t3);font-family:'Inter',sans-serif}
.result-area.loading::before{content:'';width:16px;height:16px;border:2px solid var(--border-2);border-top-color:var(--accent);border-radius:50%;animation:spin .6s linear infinite;flex-shrink:0}
.result-area .r-ai{color:var(--t1);font-family:'Inter',sans-serif;line-height:1.7}
.result-area .r-ai pre{background:var(--bg-4);border:1px solid var(--border-1);padding:10px;border-radius:6px;margin:8px 0;overflow-x:auto;font-family:'JetBrains Mono',monospace;font-size:11px}
.result-area .r-ai code{font-family:'JetBrains Mono',monospace;font-size:11px;background:var(--bg-4);padding:1px 4px;border-radius:3px}
.result-area .r-ai pre code{background:none;padding:0}
.action-bar{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px}

/* ═══ ANIMATIONS ═══ */
@keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.anim-in{animation:fadeIn .3s ease}
</style>
</head>
<body>
<div id="app">

<!-- ═══ TITLEBAR ═══ -->
<div id="titlebar">
  <div class="tb-brand">
    <img src="assets/logo.png" alt="" onerror="this.style.display='none'">
    <span>LaiaiAgent</span>
    <span class="tb-version" id="ver">v0.0.1</span>
  </div>
  <div class="tb-spacer"></div>
  <div class="tb-controls">
    <button class="wb" onclick="electronAPI.winMinimize()"><svg viewBox="0 0 12 12"><line x1="1" y1="6" x2="11" y2="6" stroke="currentColor" stroke-width="1.5"/></svg></button>
    <button class="wb" onclick="electronAPI.winMaximize()"><svg viewBox="0 0 12 12"><rect x="2" y="2" width="8" height="8" rx="1" fill="none" stroke="currentColor" stroke-width="1.2"/></svg></button>
    <button class="wb x" onclick="electronAPI.winClose()"><svg viewBox="0 0 12 12"><line x1="2" y1="2" x2="10" y2="10" stroke="currentColor" stroke-width="1.5"/><line x1="10" y1="2" x2="2" y2="10" stroke="currentColor" stroke-width="1.5"/></svg></button>
  </div>
</div>

<!-- ═══ MAIN ═══ -->
<div id="main">

<!-- MODE RAIL -->
<div id="mode-rail">
  <button class="mr-btn active" id="mr-chat" onclick="switchMode('chat')" title="Chat">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
  </button>
  <button class="mr-btn" id="mr-ide" onclick="switchMode('ide')" title="IDE">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
  </button>
  <div class="mr-spacer"></div>
  <button class="mr-btn" onclick="openSettings()" title="Settings">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12.22 2h-.44a2 2 0 00-2 2v.18a2 2 0 01-1 1.73l-.43.25a2 2 0 01-2 0l-.15-.08a2 2 0 00-2.73.73l-.22.38a2 2 0 00.73 2.73l.15.1a2 2 0 011 1.72v.51a2 2 0 01-1 1.74l-.15.09a2 2 0 00-.73 2.73l.22.38a2 2 0 002.73.73l.15-.08a2 2 0 012 0l.43.25a2 2 0 011 1.73V20a2 2 0 002 2h.44a2 2 0 002-2v-.18a2 2 0 011-1.73l.43-.25a2 2 0 012 0l.15.08a2 2 0 002.73-.73l.22-.39a2 2 0 00-.73-2.73l-.15-.08a2 2 0 01-1-1.74v-.5a2 2 0 011-1.74l.15-.09a2 2 0 00.73-2.73l-.22-.38a2 2 0 00-2.73-.73l-.15.08a2 2 0 01-2 0l-.43-.25a2 2 0 01-1-1.73V4a2 2 0 00-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
  </button>
</div>

<!-- SESSION SIDEBAR -->
<div id="session-sidebar">
  <div class="ss-header">
    <button class="ss-new" onclick="newChat()" title="新建对话">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      <span>New Chat</span>
    </button>
  </div>
  <div class="ss-search-wrap">
    <input class="ss-search" id="ss-search" placeholder="搜索会话..." oninput="renderSessionList()">
  </div>
  <div class="ss-list" id="ss-list"></div>
</div>

<!-- OLD SIDEBAR DELETED (Phase 0 cleanup) -->

<!-- ═══ CONTENT ═══ -->
<div id="content" style="display:flex;flex:1;overflow:hidden">

<!-- IDE -->
<div class="mode" id="page-ide">
  <div class="ide-layout">
    <!-- File Tree -->
    <div class="ide-filetree" id="ide-filetree">
      <div class="ft-header">
        <span>Explorer</span>
        <button onclick="openFolder()" title="打开文件夹"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z"/></svg></button>
        <button onclick="refreshFileTree()" title="刷新"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 11-2.12-9.36L23 10"/></svg></button>
      </div>
      <div style="padding:4px 8px"><input id="ft-search" placeholder="搜索文件..." oninput="filterFileTree()" style="width:100%;padding:4px 8px;background:var(--bg-3);border:1px solid var(--border-1);border-radius:5px;color:var(--t1);font-size:11px;outline:none"></div>
      <div class="ft-list" id="ft-list"></div>
    </div>
    <div class="resize-handle" id="rh-tree"></div>
    <!-- Editor -->
    <div class="ide-center">
      <div class="editor-tabs" id="editor-tabs">
        <div style="margin-left:auto;display:flex;align-items:center;gap:4px;padding-right:8px">
          <button class="ct-btn" onclick="toggleQuickOpen()" title="Ctrl+P 快速打开" style="padding:2px 8px;font-size:10px">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          </button>
          <button class="ct-btn" onclick="toggleIdeTerminal()" title="终端 Ctrl+`" style="padding:2px 8px;font-size:10px">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
          </button>
          <button class="ct-btn" onclick="toggleIdeChat()" title="AI Chat" style="padding:2px 8px;font-size:10px" id="ide-chat-toggle">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
          </button>
        </div>
      </div>
      <div id="monaco-container">
        <div class="ed-welcome" id="ed-welcome">
          <img src="assets/logo.png" alt="LaiaiAgent" style="width:56px;height:56px;border-radius:14px;opacity:.6;margin-bottom:4px">
          <h3 style="font-size:18px;font-weight:800;letter-spacing:-.3px">LaiaiAgent IDE</h3>
          <p style="margin-bottom:20px">AI 驱动的智能代码编辑器</p>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;width:280px">
            <button class="btn btn-s btn-sm" onclick="toggleQuickOpen()" style="justify-content:center"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg> Ctrl+P</button>
            <button class="btn btn-s btn-sm" onclick="toggleIdeTerminal()" style="justify-content:center"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg> Ctrl+`</button>
          </div>
          <div style="margin-top:24px;display:flex;flex-direction:column;gap:6px;font-size:11px;color:var(--t4)">
            <span><kbd style="background:var(--bg-3);padding:1px 5px;border-radius:3px;font-family:'JetBrains Mono',monospace;font-size:10px">Ctrl+S</kbd> 保存文件</span>
            <span><kbd style="background:var(--bg-3);padding:1px 5px;border-radius:3px;font-family:'JetBrains Mono',monospace;font-size:10px">Ctrl+W</kbd> 关闭标签</span>
            <span>右键选中代码 → 发送到 AI Chat</span>
          </div>
        </div>
      </div>
      <!-- Bottom Terminal -->
      <div class="ide-bottom-term" id="ide-bottom-term">
        <div class="ide-bottom-term-bar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
          <span>Terminal</span>
          <button onclick="toggleIdeTerminal()" style="margin-left:auto;background:none;border:none;color:var(--t3);cursor:pointer;font-size:12px;padding:2px 6px;border-radius:3px" title="关闭终端">✕</button>
        </div>
        <div id="ide-term-container"></div>
      </div>
    </div>
    <div class="resize-handle" id="rh-chat" style="display:none"></div>
    <!-- Chat Panel (reuses existing chat system) -->
    <div class="ide-chat" id="ide-chat">
      <div class="chat-topbar" style="border-bottom:1px solid var(--border-0)">
        <span style="font-size:11px;font-weight:600;color:var(--t3);padding:0 8px">AI Chat</span>
        <div class="chat-sessions-scroll" id="ide-chat-sessions" style="flex:1"></div>
        <button class="chat-new-btn" onclick="newChat();renderIdeChatSessions()" title="新建对话"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg></button>
      </div>
      <div class="tw-main" id="ide-chat-scroll" style="flex:1;overflow-y:auto">
        <div class="tw-main-inner" id="ide-chat-messages" style="padding:16px"></div>
      </div>
      <div class="tw-input-area" style="border-top:1px solid var(--border-0);padding:8px 12px 12px">
        <div class="tw-input-wrap" style="max-width:100%">
          <textarea class="tw-input" id="ide-chat-input" rows="1" placeholder="Ask AI..." onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();sendIdeChat()}" oninput="autoResize(this)" style="font-size:12px;padding:8px 12px;border-radius:10px"></textarea>
          <button class="tw-send" onclick="sendIdeChat()" style="width:34px;height:34px;border-radius:8px"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg></button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- TERMINAL -->
<div class="mode active" id="page-terminal">
  <div class="term-bar" style="display:none">
    <span class="dot" id="td" style="background:var(--t4)"></span>
    <span class="status" id="ts" data-i18n="term.idle">Idle</span>
    <span class="spacer"></span>
    <div class="term-mode-tabs">
      <button class="term-mode-tab active" onclick="setTermMode('chat')" id="tab-chat">Chat</button>
      <button class="term-mode-tab" onclick="setTermMode('terminal')" id="tab-term">Terminal</button>
    </div>
    <select class="term-sel" id="tp" title="LaiaiAgent Model"></select>
    <button class="btn btn-p btn-sm" id="bt-start" onclick="startTerm()">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"/></svg>
      <span data-i18n="term.start">Start</span>
    </button>
    <button class="btn btn-d btn-sm" id="bt-stop" onclick="stopTerm()" style="display:none">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="6" y="6" width="12" height="12" rx="2"/></svg>
      <span data-i18n="term.stop">Stop</span>
    </button>
  </div>
  <div id="term-area" class="mode-chat">
    <!-- Web UI Chat View -->
    <div class="tw" id="tw">
      <div class="chat-topbar">
        <div class="chat-sessions-scroll" id="chat-session-list"></div>
        <button class="chat-new-btn" onclick="newChat()" title="新建对话">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        </button>
      </div>
      <div class="tw-main" id="chat-scroll">
        <div class="tw-main-inner">
          <!-- Hero (hidden when messages exist) -->
          <div class="tw-hero" id="chat-hero">
            <img class="tw-hero-logo" src="assets/logo.png" alt="LaiaiAgent" onerror="this.style.display='none'">
            <h2 data-i18n="term.wtitle">欢迎回来！</h2>
            <div class="tw-subtitle" data-i18n="term.wdesc">LaiaiAgent 智能编程助手，随时为你服务。</div>
            <div class="tw-feature" data-i18n="term.feature">支持全模型聚合，最高1M上下文 · 5x更大空间，同等性价比</div>
          </div>
          <div class="tw-grid" id="chat-quick-grid">
            <div class="tw-card" onclick="sendQuick('帮我分析当前项目结构')">
              <div class="tw-card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V9z"/><polyline points="13 2 13 9 20 9"/></svg></div>
              <div class="tw-card-body"><div class="tw-card-t" data-i18n="tw.analyze">分析项目</div><div class="tw-card-d" data-i18n="tw.analyze_d">理解代码结构与架构</div></div>
            </div>
            <div class="tw-card" onclick="sendQuick('帮我写一个函数')">
              <div class="tw-card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg></div>
              <div class="tw-card-body"><div class="tw-card-t" data-i18n="tw.code">编写代码</div><div class="tw-card-d" data-i18n="tw.code_d">智能代码生成与编辑</div></div>
            </div>
            <div class="tw-card" onclick="sendQuick('帮我修复这个bug')">
              <div class="tw-card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg></div>
              <div class="tw-card-body"><div class="tw-card-t" data-i18n="tw.fix">修复问题</div><div class="tw-card-d" data-i18n="tw.fix_d">诊断并修复 Bug</div></div>
            </div>
            <div class="tw-card" onclick="sendQuick('帮我执行 git status')">
              <div class="tw-card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg></div>
              <div class="tw-card-body"><div class="tw-card-t" data-i18n="tw.terminal">执行命令</div><div class="tw-card-d" data-i18n="tw.terminal_d">运行终端命令与脚本</div></div>
            </div>
          </div>
          <!-- Chat messages container -->
          <div class="chat-messages" id="chat-messages"></div>
        </div>
      </div>
      <div class="tw-input-area">
        <div class="tw-input-wrap">
          <!-- [+] Action Menu Button -->
          <div style="position:relative;flex-shrink:0">
            <button class="action-plus" onclick="toggleActionMenu()" title="更多功能">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </button>
            <div class="ct-menu" id="action-menu" style="bottom:calc(100% + 8px);min-width:220px">
              <div class="ct-menu-item" onclick="closeActionMenu();chatAttach()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.44 11.05l-9.19 9.19a6 6 0 01-8.49-8.49l9.19-9.19a4 4 0 015.66 5.66l-9.2 9.19a2 2 0 01-2.83-2.83l8.49-8.48"/></svg>上传文件</div>
              <div class="ct-menu-item" onclick="closeActionMenu();insertCmd('/image ')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>生成图片</div>
              <div class="ct-menu-item" onclick="closeActionMenu();insertCmd('/tts ')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M19.07 4.93a10 10 0 010 14.14"/></svg>语音合成</div>
              <div style="height:1px;background:var(--border-1);margin:4px 0"></div>
              <div class="ct-menu-item" onclick="closeActionMenu();runSkillInChat('审查当前项目代码变更，检查质量和bug')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>代码审查</div>
              <div class="ct-menu-item" onclick="closeActionMenu();runSkillInChat('分析当前项目结构和技术栈')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V9z"/><polyline points="13 2 13 9 20 9"/></svg>分析项目</div>
              <div class="ct-menu-item" onclick="closeActionMenu();runSkillInChat('为当前变更生成简洁的commit信息')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>生成 Commit</div>
              <div class="ct-menu-item" onclick="closeActionMenu();runSkillInChat('检查安全漏洞和敏感信息泄露')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>安全扫描</div>
            </div>
          </div>
          <textarea class="tw-input" id="tw-input" rows="1" placeholder="输入消息，或使用 + 菜单..." onkeydown="chatKeyDown(event)" oninput="autoResize(this)" autocomplete="off"></textarea>
          <button class="tw-send" id="tw-send-btn" onclick="sendChat()" title="Send">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
          </button>
        </div>
        <div class="chat-input-footer">
          <div style="position:relative">
            <button class="ct-btn" onclick="toggleModelMenu()" id="ct-model-btn" title="切换模型">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/></svg>
              <span id="ct-model-name">模型</span>
            </button>
            <div class="ct-menu" id="ct-model-menu" style="bottom:calc(100% + 4px);left:0;min-width:280px;max-height:360px;overflow-y:auto"></div>
          </div>
          <span class="chat-input-hint">Enter 发送 · Shift+Enter 换行</span>
        </div>
      </div>
    </div>
    <div class="term-loading" id="tl" style="display:none">
      <div class="spinner"></div>
      <span class="term-loading-text" data-i18n="term.starting">正在启动 LaiaiAgent...</span>
    </div>
    <div id="term-container"></div>
  </div>
</div>

<!-- LEGACY PAGES (hidden, kept for JS compat until Phase 3 rewrite) -->
<div class="page" id="page-sessions">
  <div class="ph">
    <h2 data-i18n="sess.title">Session History</h2>
    <p data-i18n="sess.desc">Browse and resume previous conversations.</p>
    <div class="ph-actions">
      <input type="text" id="sess-search" placeholder="Search sessions..." style="flex:1;padding:7px 12px;background:var(--bg-3);border:1px solid var(--border-1);border-radius:8px;color:var(--t1);font-size:12px;outline:none" oninput="filterSessions()">
      <button class="btn btn-s btn-sm" onclick="loadSessions()">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/></svg>
        <span data-i18n="btn.refresh">Refresh</span>
      </button>
    </div>
  </div>
  <div class="pb" id="sess-list"></div>
</div>

<!-- PROVIDERS -->
<div class="page" id="page-providers">
  <div class="ph">
    <h2 data-i18n="prov.title">API Providers</h2>
    <p data-i18n="prov.desc">Manage AI API connections. Switch between providers instantly.</p>
    <div class="ph-actions">
      <button class="btn btn-p btn-sm" onclick="showAddProv()">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        <span data-i18n="prov.add">Add Provider</span>
      </button>
    </div>
  </div>
  <div class="pb" id="prov-list"></div>
</div>

<!-- MODELS -->
<div class="page" id="page-models">
  <div class="ph">
    <h2 data-i18n="model.title">Models</h2>

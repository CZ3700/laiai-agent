function domainToUrl(domain){
  domain=domain.trim().replace(/^https?:\/\//,'').replace(/\/+$/,'');
  if(!domain)return '';
  // Common patterns: auto-append /v1 for known providers
  if(domain.includes('/')){
    // User typed a path, use as-is
    return 'https://'+domain;
  }
  return 'https://'+domain;
}

